{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Orion desktop window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "fs:default",
    "dialog:default",
    "notification:default",
    "autostart:default",
    "window-state:default",
    "opener:default",
    "global-shortcut:default",
    "updater:default"
  ]
}
