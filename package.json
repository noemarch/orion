    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.4"
